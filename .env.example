# Скопируйте в .env и задайте свои значения.
# .env не попадает в репозиторий.

# --- База данных ---
DB_USER=pulse
DB_PASSWORD=change_me_pulse_password
DB_NAME=pulse_dev
# Порт на хосте (внутри сети Compose приложение всегда ходит на db:5432).
# 5434 выбран, чтобы не конфликтовать с локальными Postgres на 5432 и 5433.
DB_PORT=5434

# --- Приложение ---
# Сгенерировать: mix phx.gen.secret
SECRET_KEY_BASE=change_me_generate_with_mix_phx_gen_secret
# Секрет подписи токенов аутентификации. Сгенерировать случайную строку.
TOKEN_SIGNING_SECRET=change_me_random_token_signing_secret
# Ключ шифрования персональных данных (ИИН, реквизиты), ровно 32 символа.
# Сгенерировать: mix run -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
# В dev/test можно не задавать — используется стендовое значение.
CLOAK_KEY=change_me_generate_32_byte_key_here
PHX_HOST=localhost
# Порт приложения на хосте
WEB_PORT=4000

# --- Первый администратор (создаётся сидом) ---
ADMIN_EMAIL=admin@qinalma.local
ADMIN_PASSWORD=admin12345678

# --- pgAdmin (профиль tools) ---
PGADMIN_EMAIL=admin@qinalma.local
PGADMIN_PASSWORD=change_me_pgadmin_password
