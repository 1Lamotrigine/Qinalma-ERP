# Контекст сборки Docker. Всё, что пересобирается внутри образа,
# не должно попадать в контекст: иначе в образ уезжают локальные
# артефакты (в том числе устаревшие собранные ассеты).

# Сборка и зависимости хоста
_build/
deps/
.hex/
.elixir_ls/
.elixir-tools/

# Собранные ассеты: их создаёт `mix assets.deploy` внутри образа
priv/static/assets/
priv/static/cache_manifest.json
priv/static/*.gz
priv/static/favicon-*.ico
priv/static/robots-*.txt
.tailwind_cache/

# Секреты и локальная конфигурация
.env
.env.*
!.env.example

# Инструменты разработчика и мусор
.git/
.gitignore
.github/
cover/
doc/
test/
*.beam
*.dump
.DS_Store
erl_crash.dump
README.md
AGENTS.md
